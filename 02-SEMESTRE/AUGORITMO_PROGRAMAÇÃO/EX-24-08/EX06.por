programa
{
	
	funcao inicio()
	{
		inteiro num1, num2, soma, sub, mult, div
		
		escreva("Digite o primeiro numero: ")
		leia(num1)
		escreva("Digite o segundo numero: ")
		leia(num2)

		soma = num1 + num2
		sub = num1 - num2
		mult = num1 * num2
		div = num1 / num2

		escreva("Soma: ", soma, "\n")
		escreva("Subtração: ", sub, "\n")
		escreva("Multiplicação: ", mult, "\n")
		escreva("Divisão: ", div, "\n")
	}
}s
