programa
{
	
	funcao inicio()
	{
		inteiro num1
		inteiro num2
		inteiro soma

		escreva("Digite o primeiro numero: ")
		leia(num1)
		escreva("Digite o seundo numero: ")
		leia(num2)

		soma = num1 + num2

		escreva("a soma dos valores é: ", soma)
	}
}
