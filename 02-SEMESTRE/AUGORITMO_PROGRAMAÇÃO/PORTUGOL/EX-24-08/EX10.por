programa
{
	
	funcao inicio()
	{
		inteiro graus, fahrenheit

		escreva("Digite os graus°: ")
		leia(graus)

		fahrenheit = ( graus * 9 / 5 ) + 32

		escreva("==================================\n")
		escreva(graus, "° em fahrenheit: ", fahrenheit, "°F\n")
		escreva("==================================")
	}
}
