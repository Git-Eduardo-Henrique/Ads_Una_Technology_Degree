programa
{
	
	funcao inicio()
	{
		cadeia nome
		cadeia curso
		cadeia cidade
		inteiro idade

		escreva("==================================\n")
		escreva("insira nome: ")
		leia(nome)
		escreva("insira curso: ")
		leia(curso)
		escreva("insira cidade: ")
		leia(cidade)
		escreva("insira idade: ")
		leia(idade)
		escreva("==================================\n")

		escreva("seu nome é: ", nome, "\n")
		escreva("seu curso é: ", curso, "\n")
		escreva("sua cidade é: ", cidade, "\n")
		escreva("sua idade é: ", idade, "\n")
		escreva("==================================")
	}
}
