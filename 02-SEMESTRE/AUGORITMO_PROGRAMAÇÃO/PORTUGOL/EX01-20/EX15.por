programa
{
	
	funcao inicio()
	{
		inteiro num

		escreva("Digite um numero: ")
		leia(num)

		escreva("===========================================\n")

		se (num % 2 == 1) {
			escreva("Seu número é: IMPAR\n")
		} senao {
			escreva("Seu número é: PAR\n")
		}

		escreva("===========================================")
	}
}
