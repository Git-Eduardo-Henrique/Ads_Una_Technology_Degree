programa
{
	
	funcao inicio()
	{
		inteiro larg, alt, area

		escreva("Digite a largura do retangulo (cm): ")
		leia(larg)
		escreva("Digite a altura do retangulo (cm): ")
		leia(alt)

		area = larg * alt

		escreva("======================================\n")
		escreva("A área do retangulo é: ", area, " cm³\n")
		escreva("======================================")
	}
}
