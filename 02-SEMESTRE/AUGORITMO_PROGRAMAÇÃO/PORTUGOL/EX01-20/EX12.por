programa
{
	
	funcao inicio()
	{
		inteiro media

		escreva("Digite a média do aluno: ")
		leia(media)

		escreva("================================\n")
		escreva("sua média é de: ", media, "\n")

		se (media >= 7) {
			escreva("você está APROVADO\n")
		} senao {
			escreva("você está REPROVADO\n")
		}

		escreva("================================")
	}
}
